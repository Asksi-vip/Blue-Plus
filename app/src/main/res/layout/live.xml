<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#050505">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="رجوع"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بث مباشر"
            android:textStyle="bold"
            android:textColor="#FF1F3D"
            android:textSize="14sp"
            android:padding="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="افلام"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مسلسلات"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="0.6"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:background="@drawable/search_bg"
            android:gravity="center_vertical"
            android:paddingStart="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_material_search"
                android:tint="#FFFFFF"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="بحث"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textColorHint="#77FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/list_category"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:background="#101010"
            android:divider="#1F1F1F"
            android:dividerHeight="1dp"/>

        <ListView
            android:id="@+id/list_channels"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="#161616"
            android:divider="#1F1F1F"
            android:dividerHeight="1dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#000000">

            <com.google.android.exoplayer2.ui.StyledPlayerView
                android:id="@+id/player_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:use_artwork="false"
                app:use_controller="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:gravity="end|center_vertical"
                android:padding="10dp">

                <Button
                    android:layout_width="140dp"
                    android:layout_height="45dp"
                    android:text="بحث"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/red_btn"/>

                <Button
                    android:layout_width="180dp"
                    android:layout_height="45dp"
                    android:text="المفضلة"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/red_btn"/>

                <Button
                    android:layout_width="140dp"
                    android:layout_height="45dp"
                    android:text="القفل"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/red_btn"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
