<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/linear1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Control Bar -->
        <LinearLayout
            android:id="@+id/linear2"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:background="@drawable/player_top_gradient">

            <!-- Title & Back Button Container -->
            <LinearLayout
                android:id="@+id/linear14"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_weight="1" />

            <!-- Subtitle, Audio & Fullscreen Buttons Container -->
            <LinearLayout
                android:id="@+id/linear15"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical|right"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Center Area (Loading Indicator) -->
        <LinearLayout
            android:id="@+id/linear3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:indeterminate="true"
                android:indeterminateTint="#2196F3"
                android:indeterminateTintMode="src_in"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom Controls Bar (Gradient container) -->
        <LinearLayout
            android:id="@+id/linear4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="35dp"
            android:paddingBottom="20dp"
            android:background="@drawable/player_bottom_gradient">

            <!-- Progress Bar Row -->
            <LinearLayout
                android:id="@+id/linear10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/linear12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/exo_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:paddingRight="8dp"
                        android:focusable="false" />

                    <com.google.android.exoplayer2.ui.DefaultTimeBar
                        android:id="@+id/exo_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:played_color="#2196F3"
                        app:buffered_color="#4D2196F3"
                        app:unplayed_color="#33FFFFFF"
                        app:scrubber_color="#2196F3"
                        app:scrubber_enabled_size="12dp"
                        app:scrubber_disabled_size="0dp" />

                    <TextView
                        android:id="@+id/exo_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="13sp"
                        android:textColor="#CBCDC8"
                        android:paddingLeft="8dp"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Buttons Control Row (Hidden by Java code in VOD Player but kept for compatibility) -->
            <LinearLayout
                android:id="@+id/linear20"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="visible">

                <!-- Rewind Button -->
                <ImageView
                    android:id="@+id/exo_rew"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ic_rew"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <!-- Play Button -->
                <ImageView
                    android:id="@+id/exo_play"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/vp_play_normal"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <!-- Pause Button -->
                <ImageView
                    android:id="@+id/exo_pause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/vp_pause_normal"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <!-- Fast Forward Button -->
                <ImageView
                    android:id="@+id/exo_ffwd"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ic_ff"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />



                <!-- Cast Button -->
                <ImageView
                    android:id="@+id/cast"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:src="@drawable/ic_cast_white"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <!-- PIP Button -->
                <ImageView
                    android:id="@+id/pip"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:src="@drawable/more_pip_icon"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <!-- Aspect Ratio Toggle (Dynamic Placement Target) -->
                <ImageView
                    android:id="@+id/bt_fullscreen"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ic_aspect_ratio_white"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>